# --- Database (Supabase Postgres via Prisma) ---
# Pooled connection (pgbouncer) for the app at runtime.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection, used only by Prisma Migrate.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# --- Supabase Storage (generated CV PDFs) ---
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Auth.js (NextAuth v5) ---
AUTH_SECRET="" # openssl rand -base64 33
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ❌ INACTIVO: no hay email por ahora (login solo con Google). Magic link por SMTP
# (cualquier relay — Resend, Postmark, Gmail SMTP...). Dejar vacío.
# Ejemplo: EMAIL_SERVER="smtp://user:pass@smtp.resend.com:465"
EMAIL_SERVER=""
EMAIL_FROM="Job Match ATS <no-reply@yourdomain.com>"

# --- LLM tailoring (EPIC 3) ---
# Uses the Vercel AI Gateway (model strings like "anthropic/claude-sonnet-4-5"
# or "openai/gpt-4o") — no direct provider SDK/key needed. On Vercel this is
# authenticated automatically via OIDC; locally you need a gateway key:
AI_GATEWAY_API_KEY=""
# Optional override, defaults to anthropic/claude-sonnet-4-5 (see src/lib/cv/tailor.ts):
CV_TAILOR_MODEL=""

# Only needed if a scraper sets forceRender / requiresRender (see src/lib/scrapers/fetch-html.ts):
PUPPETEER_EXECUTABLE_PATH=""

# --- Mercado Pago (EPIC 4) — ❌ INACTIVO: sin billing por ahora, dejar vacío ---
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""

# Public base URL, used for MP back_urls/notification_url.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
